/*
|--------------------------------------------------------------------------
| INTEGRACIÓN PRIVADA ADN APP -> ADN WEB
|--------------------------------------------------------------------------
*/

Route::prefix(
    'integrations/adn-app'
)
    ->middleware([
        VerifyAdnAppSignature::class,
        'throttle:120,1',
    ])
    ->group(
        function (): void {
            /*
            |--------------------------------------------------------------------------
            | CATÁLOGO MAESTRO
            |--------------------------------------------------------------------------
            */

            Route::post(
                '/catalog-products',
                [
                    AppCatalogSyncController::class,
                    'store',
                ]
            )->name(
                'integration.app.catalog.store'
            );

            /*
            |--------------------------------------------------------------------------
            | SOLICITUDES
            |--------------------------------------------------------------------------
            */

            Route::get(
                '/quote-requests/{requestNumber}',
                [
                    AppQuoteRequestController::class,
                    'show',
                ]
            )
                ->where(
                    'requestNumber',
                    'SOL-WEB-[0-9]+'
                )
                ->name(
                    'integration.app.quote.show'
                );

            Route::get(
                '/quote-requests/{requestNumber}/files/{fileId}/view',
                [
                    AppQuoteRequestController::class,
                    'previewFile',
                ]
            )
                ->where(
                    'requestNumber',
                    'SOL-WEB-[0-9]+'
                )
                ->whereNumber(
                    'fileId'
                )
                ->name(
                    'integration.app.quote.files.preview'
                );

            Route::get(
                '/quote-requests/{requestNumber}/files/{fileId}/download',
                [
                    AppQuoteRequestController::class,
                    'downloadFile',
                ]
            )
                ->where(
                    'requestNumber',
                    'SOL-WEB-[0-9]+'
                )
                ->whereNumber(
                    'fileId'
                )
                ->name(
                    'integration.app.quote.files.download'
                );
        }
    );

